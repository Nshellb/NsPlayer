<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <EditText
        android:id="@+id/renameInput"
        style="@style/Widget.NsPlayer.DialogInput"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_rename_input"
        android:gravity="center_vertical"
        android:hint="@string/rename_hint"
        android:imeOptions="actionDone"
        android:includeFontPadding="false"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="0dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <ProgressBar
        android:id="@+id/renameProgress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/renameStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
        android:visibility="gone" />

    <Button
        android:id="@+id/renameRetry"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/media_details_retry"
        android:visibility="gone" />
</LinearLayout>
