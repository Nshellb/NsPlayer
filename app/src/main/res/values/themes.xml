<resources>
    <style name="Theme.NsPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/on_brand_primary</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorSecondaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnSecondary">@color/on_brand_primary</item>
        <item name="colorSurface">@color/surface_default</item>
        <item name="colorOnSurface">@color/on_surface_default</item>
        <item name="android:colorBackground">@color/surface_default</item>
        <item name="android:windowBackground">@color/surface_default</item>
        <item name="colorControlActivated">@color/brand_primary</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.NsPlayer.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.NsPlayer.BottomSheetDialog</item>
    </style>

    <style name="ThemeOverlay.NsPlayer.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorControlActivated">@color/brand_primary</item>
        <item name="colorSurface">@color/surface_default</item>
        <item name="colorOnSurface">@color/on_surface_default</item>
    </style>

    <style name="ThemeOverlay.NsPlayer.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorControlActivated">@color/brand_primary</item>
        <item name="colorSurface">@color/surface_default</item>
        <item name="colorOnSurface">@color/on_surface_default</item>
    </style>
</resources>
